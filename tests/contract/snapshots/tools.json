 "marketplace": {
  "create_proposal_draft": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
   },
   "input": {
    "properties": {
     "bid_amount": {
      "minimum": 0,
      "title": "Bid Amount",
      "type": "number"
     },
     "cover_letter": {
      "minLength": 1,
      "title": "Cover Letter",
      "type": "string"
     },
     "dry_run": {
      "default": false,
      "description": "True returns the exact payload and cost, sends nothing",
      "title": "Dry Run",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Unique key per logical write. Same key returns the same result and never repeats the side effect.",
      "maxLength": 128,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
     },
     "job_id": {
      "title": "Job Id",
      "type": "string"
     },
     "screening_answers": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Screening Answers"
     }
    },
    "required": [
     "job_id",
     "cover_letter",
     "bid_amount",
     "idempotency_key"
    ],
    "title": "create_proposal_draftArguments",
    "type": "object"
   },
   "output": {
    "additionalProperties": true,
    "description": "Result of create_proposal_draft or submit_proposal. With dry_run true nothing is stored or\nspent and `would_send` holds the exact payload.",
    "properties": {
     "balance_after": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Balance After"
     },
     "connects_cost": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Connects Cost"
     },
     "connects_spent": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Connects Spent"
     },
     "draft_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Draft Id"
     },
     "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
     },
     "idempotent_replay": {
      "default": false,
      "title": "Idempotent Replay",
      "type": "boolean"
     },
     "proposal_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Proposal Id"
     },
     "status": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Status"
     },
     "would_send": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Would Send"
     }
    },
    "title": "ProposalResult",
    "type": "object"
   }
  },
