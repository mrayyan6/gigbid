# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Secrets are left empty on purpose. Generate them as noted. Lines starting with # are optional.

# == Marketplace ==
# gigsim (adapter called directly), mcp (through the Marketplace MCP server) or upwork (live)
MARKETPLACE_MODE=gigsim
GIGSIM_URL=http://localhost:9000
GIGSIM_TOKEN=gigsim-dev-token
# Marketplace MCP server (HTTP transport needs a bearer token shared with the client)
MARKETPLACE_MCP_URL=
MARKETPLACE_MCP_PORT=9100
MARKETPLACE_MCP_TOKEN=
#MARKETPLACE_BACKEND=gigsim
#MARKETPLACE_RATE_PER_MIN=
# Workspace MCP server
WORKSPACE_MCP_PORT=9200
WORKSPACE_MCP_TOKEN=
#WORKSPACE_PATH=
# Portfolio MCP server (FASTMCP_HOST and FASTMCP_PORT are read by the MCP SDK for --http)
#PORTFOLIO_DATA=
PORTFOLIO_PERSONA=ai_ml
RAG_VARIANT=v2_hybrid
MCP_HOST=127.0.0.1
#FASTMCP_HOST=127.0.0.1
#FASTMCP_PORT=9101
#AUDIT_LOG_PATH=

# == API and auth ==
API_HOST=127.0.0.1
API_PORT=8000
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from agent.security.tokens import new_key; print(new_key())"
TOKEN_ENCRYPTION_KEY=
# Reviewer account seeded on API start (idempotent). Password is shared only in the private
# Classroom comment. Rotate it by changing this value and restarting (see docs/RUNBOOK.md).
REVIEWER_EMAIL=reviewer@gigbid.demo
REVIEWER_PASSWORD=
REVIEWER_PERSONA=ai_ml
# Set to 1 only in tests (enables POST /api/test/marketplace-down, skips .env loading)
#GIGBID_TEST_MODE=

# == State ==
# Empty DATABASE_URL means SQLite files; empty REDIS_URL means inline background tasks.
# Neon or local: postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Upstash or local: redis://host:6379 (use rediss:// for TLS)
REDIS_URL=
# Only used by docker compose for the bundled Postgres container
POSTGRES_PASSWORD=
#CHECKPOINT_DB=
#USERS_DB=

# == Models ==
# open (Ollama) or open_hosted (Groq), see agent/config_extra.yaml routing
MODEL_PROFILE=open
#GIGBID_PROFILE=
# 1 routes writer and critic through an LLM, 0 or unset uses deterministic templates
#LLM_ENABLED=
OLLAMA_BASE_URL=http://localhost:11434
# Groq (open weights, hosted). Needed only for the open_hosted profile.
GROQ_API_KEY=

# == Tracing ==
# No key means tracing is off. PII is masked by agent/security/pii.py before anything is sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid

# == Data tooling (only for scripts/fetch_datasets.py) ==
KAGGLE_USERNAME=
KAGGLE_KEY=
